{
  "name": "rhubarb",
  "version": "1.0.0",
  "description": "A personal pi configuration for subagents, workflows, and web research",
  "main": "index.js",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types extensions/**/*.test.ts",
    "format": "prettier --write \"extensions/**/*.{ts,md,cjs}\" \"skills/**/*.md\" \"*.{json,md}\"",
    "format:check": "prettier --check \"extensions/**/*.{ts,md,cjs}\" \"skills/**/*.md\" \"*.{json,md}\""
  },
  "keywords": [],
  "type": "module",
  "private": true,
  "license": "MIT",
  "dependencies": {
    "acorn": "^8.17.0",
    "firecrawl": "^4.30.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.81.1",
    "@earendil-works/pi-coding-agent": "^0.81.1",
    "@earendil-works/pi-tui": "^0.81.1",
    "@types/node": "^26.1.1",
    "prettier": "^3.9.6",
    "typebox": "^1.3.6",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./extensions/firecrawl/index.ts",
      "./extensions/subagents/index.ts",
      "./extensions/workflows/index.ts",
      "./extensions/usage-tracking/index.ts",
      "./extensions/background-terminals/index.ts",
      "./extensions/ask-user/index.ts",
      "./extensions/file-search/index.ts",
      "./extensions/ui-customization/index.ts",
      "./extensions/convenience/index.ts"
    ],
    "skills": [
      "./skills/subagents",
      "./skills/workflows",
      "./skills/background-terminals",
      "./skills/svelte-best-practices",
      "./skills/slice-loop-workflow"
    ],
    "themes": [
      "./themes/catppuccin-mocha.json"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
